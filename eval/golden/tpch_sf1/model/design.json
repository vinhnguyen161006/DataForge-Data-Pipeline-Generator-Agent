  "metrics": [
    {
      "name": "revenue_after_discount",
      "definition": "Doanh thu sau chi\u1ebft kh\u1ea5u",
      "expression": "sum(l_extendedprice * (1 - l_discount))",
      "fact_table": "fact_lineitem",
      "rationale": "\u0110\u1ecbnh ngh\u0129a c\u1ee7a truy v\u1ea5n TPC-H (ngu\u1ed3n th\u1ee9 c\u1ea5p tr\u00edch \u0111\u1eb7c t\u1ea3 Rev 2.17.1); x\u00e1c nh\u1eadn m\u1ed9t ph\u1ea7n.",
      "open_questions": [
        "Ch\u01b0a \u0111\u1ecdc \u0111\u1eb7c t\u1ea3 g\u1ed1c; c\u1ea7n \u0111\u1ed1i chi\u1ebfu v\u1edbi tpch_answers()."
      ]
    },
    {
      "name": "revenue_after_tax",
      "definition": "Doanh thu sau chi\u1ebft kh\u1ea5u v\u00e0 thu\u1ebf",
      "expression": "sum(l_extendedprice * (1 - l_discount) * (1 + l_tax))",
      "fact_table": "fact_lineitem",
      "rationale": "Bi\u1ec3u th\u1ee9c sum_charge c\u1ee7a truy v\u1ea5n Q1 (ngu\u1ed3n th\u1ee9 c\u1ea5p).",
      "open_questions": [
        "X\u00e1c nh\u1eadn m\u1ed9t ph\u1ea7n."
      ]
    },
    {
      "name": "total_quantity",
      "definition": "T\u1ed5ng s\u1ed1 l\u01b0\u1ee3ng b\u00e1n",
      "expression": "sum(l_quantity)",
      "fact_table": "fact_lineitem",
      "rationale": "\u0110\u1ebfm s\u1ed1 l\u01b0\u1ee3ng tr\u00ean d\u00f2ng h\u00e0ng.",
      "open_questions": []
    },
    {
      "name": "order_count",
      "definition": "S\u1ed1 \u0111\u01a1n",
