  "metrics": [
    {
      "name": "revenue_items",
      "definition": "Doanh thu h\u00e0ng h\u00f3a (kh\u00f4ng g\u1ed3m ph\u00ed); c\u1ea7n join fact_order_item v\u1edbi dim_order theo order_id",
      "expression": "sum(fact_order_item.price) filter (where dim_order.order_status = 'delivered')",
      "fact_table": "fact_order_item",
      "rationale": "C\u00f4ng th\u1ee9c \u0111\u1ec1 xu\u1ea5t: ch\u1ec9 \u0111\u01a1n delivered, t\u00ednh theo price.",
      "open_questions": [
        "OLI-04: c\u00f3 n\u00ean d\u00f9ng delivered hay m\u1ecdi tr\u1ea1ng th\u00e1i tr\u1eeb canceled; c\u00f3 g\u1ed3m ph\u00ed kh\u00f4ng?"
      ]
    },
    {
      "name": "revenue_with_freight",
      "definition": "Doanh thu g\u1ed3m ph\u00ed v\u1eadn chuy\u1ec3n; c\u1ea7n join fact_order_item v\u1edbi dim_order theo order_id",
      "expression": "sum(fact_order_item.price + fact_order_item.freight_value) filter (where dim_order.order_status = 'delivered')",
      "fact_table": "fact_order_item",
      "rationale": "Ph\u01b0\u01a1ng \u00e1n th\u1ee9 hai c\u1ee7a OLI-04.",
      "open_questions": [
        "OLI-04 ch\u01b0a quy\u1ebft \u0111\u1ecbnh."
      ]
    },
    {
      "name": "paid_total",
      "definition": "T\u1ed5ng ti\u1ec1n \u0111\u00e3 thanh to\u00e1n",
      "expression": "sum(payment_value)",
      "fact_table": "fact_payment",
      "rationale": "Ph\u01b0\u01a1ng \u00e1n c\u1ee7a OLI-04 d\u1ef1a tr\u00ean thanh to\u00e1n.",
      "open_questions": [
        "OLI-01: kh\u00f4ng \u0111\u01b0\u1ee3c c\u1ed9ng chung v\u1edbi revenue_items trong c\u00f9ng truy v\u1ea5n."
      ]
    },
    {
      "name": "order_count",
      "definition": "S\u1ed1 \u0111\u01a1n",
      "expression": "count(distinct order_id)",
      "fact_table": "dim_order",
      "rationale": "\u0110\u1ebfm \u0111\u01a1n theo order_id.",
      "open_questions": [
        "fact_table tr\u1ecf t\u1edbi dim_order v\u00ec ch\u1ec9 s\u1ed1 n\u00e0y kh\u00f4ng c\u00f3 fact ri\u00eang (schema gap nh\u01b0 OULAD)."
      ]
    },
    {
      "name": "customer_unique_count",
      "definition": "S\u1ed1 kh\u00e1ch th\u1eadt",
      "expression": "count(distinct customer_unique_id)",
      "fact_table": "dim_customer",
      "rationale": "\u0110\u1ebfm kh\u00e1ch theo customer_unique_id.",
      "open_questions": [
        "OLI-02 ch\u01b0a quy\u1ebft \u0111\u1ecbnh."
      ]
    },
    {
      "name": "installment_order_rate",
      "definition": "T\u1ec9 l\u1ec7 \u0111\u01a1n tr\u1ea3 g\u00f3p",
      "expression": "count(distinct order_id) filter (where payment_installments > 1) * 1.0 / count(distinct order_id)",
      "fact_table": "fact_payment",
      "rationale": "T\u1ec9 l\u1ec7 \u0111\u01a1n c\u00f3 tr\u1ea3 g\u00f3p theo payment_installments.",
      "open_questions": []
    },
    {
      "name": "avg_review_score",
      "definition": "\u0110i\u1ec3m \u0111\u00e1nh gi\u00e1 trung b\u00ecnh theo \u0111\u00e1nh gi\u00e1",
      "expression": "avg(review_score)",
      "fact_table": "fact_review",
      "rationale": "T\u00ednh theo \u0111\u00e1nh gi\u00e1, kh\u00f4ng theo d\u00f2ng h\u00e0ng, \u0111\u1ec3 tr\u00e1nh \u0111\u1ebfm tr\u00f9ng.",
      "open_questions": [
        "OLI-03 ch\u01b0a quy\u1ebft \u0111\u1ecbnh."
      ]
    }
  ],
