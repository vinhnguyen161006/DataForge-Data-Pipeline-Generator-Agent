  "metrics": [
    {
      "name": "enrollment_count",
      "definition": "S\u1ed1 l\u01b0\u1ee3t h\u1ecdc",
      "expression": "count(*)",
      "fact_table": "dim_enrollment",
      "rationale": "\u0110\u1ebfm l\u01b0\u1ee3t h\u1ecdc (M01); tr\u01b0\u1eddng fact_table tr\u1ecf t\u1edbi dimension v\u00ec ch\u1ec9 s\u1ed1 n\u00e0y kh\u00f4ng c\u00f3 fact ri\u00eang.",
      "open_questions": [
        "Schema gap: fact_table nh\u1eadn t\u00ean dimension trong tr\u01b0\u1eddng h\u1ee3p n\u00e0y; c\u1ea7n Tu\u1ea5n Anh x\u00e1c nh\u1eadn cho ph\u00e9p."
      ]
    },
    {
      "name": "withdrawal_rate",
      "definition": "T\u1ec9 l\u1ec7 r\u00fat h\u1ecdc theo final_result = Withdrawn",
      "expression": "count(*) filter (where final_result = 'Withdrawn') * 1.0 / count(*)",
      "fact_table": "dim_enrollment",
      "rationale": "M04; c\u00f4ng th\u1ee9c theo k\u1ebft qu\u1ea3 cu\u1ed1i, kh\u00f4ng theo ng\u00e0y h\u1ee7y.",
      "open_questions": [
        "N\u1ebfu \u0111\u1ecbnh ngh\u0129a theo ng\u00e0y h\u1ee7y: 'count(date_unregistration is not null)' (M09). Ch\u1edd N2."
      ]
    },
    {
      "name": "pass_rate_all",
      "definition": "T\u1ec9 l\u1ec7 \u0111\u1ea1t tr\u00ean t\u1ea5t c\u1ea3 l\u01b0\u1ee3t h\u1ecdc",
      "expression": "count(*) filter (where final_result in ('Pass','Distinction')) * 1.0 / count(*)",
      "fact_table": "dim_enrollment",
      "rationale": "M06; m\u1ed9t trong hai c\u00e1ch t\u00ednh t\u1ec9 l\u1ec7 \u0111\u1ea1t.",
      "open_questions": [
        "Q2: m\u1eabu s\u1ed1 g\u1ed3m ng\u01b0\u1eddi r\u00fat h\u1ecdc hay kh\u00f4ng; M07 l\u00e0 ph\u01b0\u01a1ng \u00e1n c\u00f2n l\u1ea1i."
      ]
    },
    {
