      "expression": "avg(score) filter (where is_banked = 0 and score is not null)",
      "fact_table": "fact_assessment_submission",
      "rationale": "M12; b\u1ecf \u0111i\u1ec3m \u0111\u01b0\u1ee3c chuy\u1ec3n t\u1eeb l\u1ea7n h\u1ecdc tr\u01b0\u1edbc.",
      "open_questions": [
