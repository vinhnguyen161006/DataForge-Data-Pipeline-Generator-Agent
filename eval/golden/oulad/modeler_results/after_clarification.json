        "dimension_keys": [
          "code_module",
          "code_presentation",
          "id_student"
        ]
      }
    ],
    "dimensions": [
      {
        "rationale": "Courses dimension provides module and presentation attributes for grouping dashboard metrics.",
        "open_questions": [],
        "name": "dim_courses",
        "business_key": [
          "code_module",
          "code_presentation"
        ],
        "source_table": "courses",
        "attributes": [
          "code_module",
          "code_presentation",
          "module_presentation_length"
        ]
      },
      {
        "rationale": "Student demographic and background attributes for filtering and segmenting student outcomes.",
        "open_questions": [],
        "name": "dim_students",
        "business_key": [
          "code_module",
          "code_presentation",
          "id_student"
